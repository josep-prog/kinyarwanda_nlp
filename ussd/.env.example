# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it is already in .gitignore.

# ── Africa's Talking (USSD gateway) ──────────────────────────────────────
AT_USERNAME=sandbox          # Change to your AT username in production
AT_API_KEY=your_api_key_here

# ── Cloud LLM fallback (optional — system works offline without this) ────
# Get a key at https://openrouter.ai
OPENROUTER_KEY=

# ── Flask ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string-in-production
PORT=5000
DEBUG=0

# ── Deployment ────────────────────────────────────────────────────────────
# The public URL of your server. Africa's Talking will POST to:
#   ${PUBLIC_URL}/ussd
# For local development, use ngrok: ngrok http 5000
PUBLIC_URL=https://your-server.example.com
